# Bu dosyayı .env olarak kopyala ve doldur. .env asla GitHub'a gitmez (.gitignore'da).

# Arka uç: vertex (Google Cloud projesi + kredi, önerilen) ya da gemini (AI Studio API anahtarı)
NIMBUS_BACKEND=vertex

# --- gemini arka ucu ---
GEMINI_API_KEY=buraya_yapistir

# --- vertex arka ucu ---
# Önce bir kez: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=proje-id
GOOGLE_CLOUD_LOCATION=eu

# Live modeli
# gemini: gemini-3.8-live
# vertex: gemini-3.8-live (tekil Avrupa bölgelerinde yok; eu ya da us-central1 kullan) ya da gemini-live-2.5-flash-native-audio
NIMBUS_MODEL=gemini-3.8-live

# Ağız senkronu ince ayarı (ms): ağız sesten önce gidiyorsa artır, geride kalıyorsa azalt (eksi olabilir)
NIMBUS_AGIZ_KAYDIR_MS=0

# Google araması (hava, haber, maç): 1 açık, 0 kapalı
NIMBUS_ARAMA=1
# Nimbus'a söylenecek konum (hava durumu vb. için)
NIMBUS_KONUM=Konya

# Görme: kamera indeksi (boş = kapalı). Komut satırından: --kamera
NIMBUS_KAMERA=
# Uyanınca bir kez bakıp görünüşe laf soksun mu (1/0)
NIMBUS_ILK_BAKIS=1
# Varsayılan kişilik (GDG Cloud Konya için: personas/gdg-konya.yaml)
NIMBUS_PERSONA=personas/nimbus.yaml

# ---------- ESP32 bedeni (Faz 2, bkz. donanim/BAGLANTI.md) ----------
# NIMBUS_ESP32=1                 # ./n her zaman ESP32 ile açılsın (yoksa: ./n --esp32)
# NIMBUS_WIFI_AD=ag-adi          # ESP32'nin bağlanacağı 2.4 GHz ağ (bu bilgisayarla aynı ağ)
# NIMBUS_WIFI_SIFRE=sifre
# NIMBUS_ESP32_ANAHTAR=          # boşsa ilk çalıştırmada otomatik üretilir
# NIMBUS_ESP32_SUNUCU=           # otomatik bulunamazsa bu bilgisayarın IP'si
# NIMBUS_ESP32_SES=70            # hoparlör seviyesi 0-100
# NIMBUS_ESP32_AGIZ_KAPALI=90    # ağız servosu açıları
# NIMBUS_ESP32_AGIZ_ACIK=60
