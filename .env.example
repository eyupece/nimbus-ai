# Bu dosyayı .env olarak kopyala ve doldur. .env asla GitHub'a gitmez (.gitignore'da).

# Arka uç: vertex (Google Cloud projesi + kredi, önerilen) ya da gemini (AI Studio API anahtarı)
NIMBUS_BACKEND=vertex

# --- gemini arka ucu ---
GEMINI_API_KEY=buraya_yapistir

# --- vertex arka ucu ---
# Önce bir kez: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=proje-id
GOOGLE_CLOUD_LOCATION=eu

# Live modeli
# gemini: gemini-3.8-live
# vertex: gemini-3.8-live (tekil Avrupa bölgelerinde yok; eu ya da us-central1 kullan) ya da gemini-live-2.5-flash-native-audio
NIMBUS_MODEL=gemini-3.8-live

# Ağız senkronu ince ayarı (ms): ağız sesten önce gidiyorsa artır, geride kalıyorsa azalt (eksi olabilir)
NIMBUS_AGIZ_KAYDIR_MS=0
